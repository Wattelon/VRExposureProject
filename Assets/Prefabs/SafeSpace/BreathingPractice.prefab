    - target: {fileID: 305211314566477590, guid: 72480d1d2b49b3e41a2ca1874c38c72a, type: 3}
      propertyPath: m_text
      value: "\u0414\u044B\u0448\u0438\u0442\u0435 \u0432\u043C\u0435\u0441\u0442\u0435
        \u0441\u043E \u0441\u0444\u0435\u0440\u043E\u0439: \u043A\u043E\u0433\u0434\u0430
        \u043E\u043D\u0430 \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u0435\u0442\u0441\u044F,
        \u0441\u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439
        \u0432\u0434\u043E\u0445 \u043D\u0430 \u0447\u0435\u0442\u044B\u0440\u0435
        \u0441\u0435\u043A\u0443\u043D\u0434\u044B \u0447\u0435\u0440\u0435\u0437
        \u043D\u043E\u0441, \u0437\u0430\u0442\u0435\u043C \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0442\u0435
        \u0434\u044B\u0445\u0430\u043D\u0438\u0435 \u043D\u0430 \u0441\u0435\u043C\u044C
        \u0441\u0435\u043A\u0443\u043D\u0434 \u0438 \u0432\u044B\u0434\u044B\u0445\u0430\u0439\u0442\u0435
        \u0432\u043E\u0441\u0435\u043C\u044C \u0441\u0435\u043A\u0443\u043D\u0434
        \u0447\u0435\u0440\u0435\u0437 \u0440\u043E\u0442, \u043A\u043E\u0433\u0434\u0430
        \u043E\u043D\u0430 \u0431\u0443\u0434\u0435\u0442 \u0441\u0436\u0438\u043C\u0430\u0442\u044C\u0441\u044F.
        \u041F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u0435 \u043F\u044F\u0442\u044C
        \u0440\u0430\u0437."
      objectReference: {fileID: 0}
