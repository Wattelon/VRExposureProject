    \u0441\u043E \u0441\u0444\u0435\u0440\u043E\u0439: \u043A\u043E\u0433\u0434\u0430
    \u043E\u043D\u0430 \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u0435\u0442\u0441\u044F,
    \u0441\u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439
