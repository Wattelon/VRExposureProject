      m_Calls: []
  m_text: "\u041E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0439\u0442\u0435\u0441\u044C
    \u0432\u043E\u043A\u0440\u0443\u0433 \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0439\u0442\u0435
    \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043D\u0430 \u043E\u0431\u044A\u0435\u043A\u0442\u044B
    \u0441 \u043E\u0431\u0432\u043E\u0434\u043A\u043E\u0439. \u0424\u043E\u043A\u0443\u0441\u0438\u0440\u0443\u0439\u0442\u0435\u0441\u044C
    \u043D\u0430 \u043D\u0438\u0445 \u0438 \u043F\u0440\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0439\u0442\u0435
    \u043F\u0440\u043E \u0441\u0435\u0431\u044F \u0438\u0445 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F,
    \u043F\u043E\u043A\u0430 \u043D\u0435 \u043D\u0430\u0439\u0434\u0451\u0442\u0435
    \u0432\u0441\u0435 \u043F\u044F\u0442\u044C. \u041A\u0430\u0436\u0434\u044B\u0439
    \u0440\u0430\u0437 \u0432\u044B\u0431\u0438\u0440\u0430\u044E\u0442\u0441\u044F
    \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u044B
    \u0438\u0437 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445."
