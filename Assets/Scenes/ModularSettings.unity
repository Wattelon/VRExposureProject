      propertyPath: m_text
      value: "\u0412 \u043B\u044E\u0431\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442,
        \u0435\u0441\u043B\u0438 \u0432\u0430\u043C \u0441\u0442\u0430\u043D\u0435\u0442
