        \u043A\u043D\u043E\u043F\u043A\u0443 \"\u041C\u0435\u043D\u044E\" \u043D\u0430
        \u043B\u0435\u0432\u043E\u043C \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440\u0435,
